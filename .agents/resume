#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.local/node-v22/bin:$HOME/.cargo/bin:$PATH"

for tool in node pnpm cargo; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Missing required tool: $tool (rerun .agents/setup)" >&2
    exit 1
  fi
done

if [[ ! -f .env ]]; then
  cp -- .env.example .env
fi
mkdir -p uploads

echo "Orb environment is ready"
