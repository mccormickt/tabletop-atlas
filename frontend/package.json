{
	"name": "frontend",
	"private": true,
	"version": "0.1.5",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test",
		"test:e2e:install": "playwright install chromium"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"msw": "^3.0.7",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"dompurify": "^3.5.0",
		"marked": "^18.2.1"
	},
	"msw": {
		"workerDirectory": [
			"static"
		]
	}
}
